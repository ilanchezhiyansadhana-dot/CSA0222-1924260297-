
#include <stdio.h>

typedef unsigned short meter_t;

#define FIXED 5000L
#define RATE2 225L
#define RATE3 450L

unsigned int consumption(meter_t previous,
                         meter_t current)
{
    return (meter_t)(current - previous);
}

long compute_bill(unsigned int units)
{
    long bill = FIXED;

    if (units > 200)
        bill += (units - 200) * RATE3;

    if (units > 100)
    {
        unsigned int slab =
            units > 200 ? 100 : units - 100;

        bill += slab * RATE2;
    }

    return bill;
}

int main(void)
{
    unsigned int previous, current, units;
    long bill;

    printf("Enter previous reading: ");

    if (scanf("%u", &previous) != 1 || previous > 65535)
    {
        printf("Invalid input\n");
        return 1;
    }

    printf("Enter current reading: ");

    if (scanf("%u", &current) != 1 || current > 65535)
    {
        printf("Invalid input\n");
        return 1;
    }

    if (current < previous &&
        !(previous > 60000 && current < 5536))
    {
        printf("Invalid meter reading\n");
        return 1;
    }

    units = consumption((meter_t)previous,
                        (meter_t)current);

    bill = compute_bill(units);

    printf("Units consumed = %u\n", units);
    printf("Total Bill = Rs %ld.%02ld\n",
           bill / 100, bill % 100);

    return 0;
}

