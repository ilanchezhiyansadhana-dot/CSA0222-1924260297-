

#include <stdio.h>
#include "billing.h"

long compute_bill(int units)
{
    long paise = FIXED_CHARGE;

    if (units > 200)
        paise += (units - 200) * 450;

    if (units > 100)
        paise += ((units > 200) ? 100 : units - 100) * 225;

#ifdef DEBUG
    printf("Debug: Units = %d, Paise = %ld\n", units, paise);
#endif

    return paise;
}

int main(void)
{
    int units = 150;
    long bill = compute_bill(units);

    printf("Total Bill = Rs %ld.%02ld\n",
           bill / 100, bill % 100);

    return 0;
}
